/* assets/style.qss */

QWidget {
  background-color: #2A2A2A;   /* nền tối */
  color: #EAEAEA;
  font-family: "Segoe UI", "Arial";
  font-size: 12pt;
}

/* Tiêu đề app */
#AppTitle {
  font-size: 16pt;
  font-weight: 700;
  color: #FFFFFF;
  margin: 6px 4px 8px 8px;
}

/* Thẻ (card) */
#Card {
  background-color: #3A3A3A;
  border-radius: 14px;
  border: 1px solid #444;
}

#CardTitle {
  font-size: 13pt;
  font-weight: 600;
  color: #FFFFFF;
}

#CardSub {
  color: #CCCCCC;
}

#CloseButton {
  background-color: #4A2A2A;
  border: 1px solid #7A3A3A;
  border-radius: 18px;
  color: #FF6B6B;
  font-size: 18pt;
  font-weight: 700;
}

#CloseButton:hover {
  background-color: #5A2A2A;
  color: #FF8A8A;
}

/* Nút DETAIL (đậm, full width) */
#DetailButton {
  background-color: #4A4A4A;
  border: 1px solid #5A5A5A;
  border-radius: 10px;
  color: #FFFFFF;
  font-weight: 700;
}
#DetailButton:hover { background-color: #565656; }
#DetailButton:pressed { background-color: #4F4F4F; }

/* Thanh + ADD NODE */
#AddBar {
  background-color: #4A4A4A;
  border: 1px solid #5A5A5A;
  border-radius: 12px;
  color: #DDDDDD;
  font-weight: 700;
  letter-spacing: .5px;
}
#AddBar:hover { background-color: #545454; }
#AddBar:pressed { background-color: #4C4C4C; }

/* QPushButton chung */
QPushButton {
  padding: 6px 12px;
}

/* QLineEdit/QSpinBox trong dialog */
QLineEdit, QSpinBox {
  background: #2F2F2F;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 6px 8px;
}
QLineEdit:focus, QSpinBox:focus {
  border-color: #6A9AE8;
}

QLabel#PumpLabel {
    font-size: 12px;
    color: #666;
}

QLabel#CropLabel {
    font-size: 12px;
    font-weight: 600;
    color: #2e7d32;
}

QLabel#PumpEmpty {
    color: #999;
    font-style: italic;
}
QFrame#Card QLabel {
    background: transparent;
}
QLabel {
    background-color: transparent;
}
#PumpArea {
  background-color: transparent;
}
#PumpButton {
  background: transparent;
  border: none;
  color: #AAA;
  text-align: left;
  padding: 4px 6px;
  font-size: 12pt;
}

#PumpButton:hover {
  color: #DDD;
}

#PumpButton:checked {
  background-color: rgba(255, 180, 0, 0.18);
  color: #FFB000;
  border-radius: 6px;
}

#CropLabel {
  font-weight: 600;
  color: #2e7d32;
}

#PumpButton[mode="MANUAL"] {
  color: #FFB000;
  font-weight: 600;
}

#PumpButton[mode="AUTO"] {
  color: #CCCCCC;
}

#PumpButton[autoType="TIMER"] {
  color: #4FC3F7;
}

#PumpOn {
  background-color: #2e7d32;
  color: white;
  font-weight: 600;
  border-radius: 6px;
  padding: 4px 10px;
}

#PumpOff {
  background-color: #b71c1c;
  color: white;
  font-weight: 600;
  border-radius: 6px;
  padding: 4px 10px;
}
QLabel[state="RUNNING"] {
  color: #2e7d32;
  font-weight: 600;
}

QLabel[state="OFF"] {
  color: #999;
}

QLabel {
  font-size: 11pt;
}
/* ===== HISTORY TABLE ===== */
QTableWidget {
  background-color: #2A2A2A;
  gridline-color: #3A3A3A;
  color: #EAEAEA;
  font-size: 11pt;
}

QHeaderView::section {
  background-color: #333333;
  color: #CCCCCC;
  padding: 6px 10px;
  border: none;
  font-weight: 600;
}

QTableWidget::item {
  padding: 6px 10px;
  border: none;
}

QTableWidget::item:selected {
  background-color: #444444;
}

QTableWidget {
  alternate-background-color: #2F2F2F;
}
#KeyboardPanel {
  background-color: #1F1F1F;
  border-top: 1px solid #3A3A3A;
  border-radius: 12px;
}
QPushButton {
    background-color: #2C2C2C;
    border: 1px solid #555;
    border-radius: 8px;
    color: #EEE;
}

QPushButton:hover {
    background-color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #555;
}

QPushButton[variant="wide"] {
    background-color: #333;
    font-weight: bold;
}

QPushButton[variant="wide"]:hover {
    background-color: #3F3F3F;
}

QPushButton[variant="wide"]:pressed {
    background-color: #555;
}
