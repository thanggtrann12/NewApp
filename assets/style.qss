/* assets/style.qss */

QWidget {
  background-color: #2A2A2A;   /* nền tối */
  color: #EAEAEA;
  font-family: "Segoe UI", "Arial";
  font-size: 12pt;
}

/* Tiêu đề app */
#AppTitle {
  font-size: 16pt;
  font-weight: 700;
  color: #FFFFFF;
  margin: 6px 4px 8px 8px;
}

/* Thẻ (card) */
#Card {
  background-color: #3A3A3A;
  border-radius: 14px;
  border: 1px solid #444;
}

#CardTitle {
  font-size: 13pt;
  font-weight: 600;
  color: #FFFFFF;
}

#CardSub {
  color: #CCCCCC;
}

/* Nút đóng trên card */
#CloseButton {
  background: transparent;
  border: none;
  color: #DD6B6B;
  font-size: 14pt;
}
#CloseButton:hover { color: #FF7B7B; }

/* Nút DETAIL (đậm, full width) */
#DetailButton {
  background-color: #4A4A4A;
  border: 1px solid #5A5A5A;
  border-radius: 10px;
  color: #FFFFFF;
  font-weight: 700;
}
#DetailButton:hover { background-color: #565656; }
#DetailButton:pressed { background-color: #4F4F4F; }

/* Thanh + ADD NODE */
#AddBar {
  background-color: #4A4A4A;
  border: 1px solid #5A5A5A;
  border-radius: 12px;
  color: #DDDDDD;
  font-weight: 700;
  letter-spacing: .5px;
}
#AddBar:hover { background-color: #545454; }
#AddBar:pressed { background-color: #4C4C4C; }

/* QPushButton chung */
QPushButton {
  padding: 6px 12px;
}

/* QLineEdit/QSpinBox trong dialog */
QLineEdit, QSpinBox {
  background: #2F2F2F;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 6px 8px;
}
QLineEdit:focus, QSpinBox:focus {
  border-color: #6A9AE8;
}

